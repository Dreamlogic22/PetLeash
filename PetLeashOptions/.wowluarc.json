{
    "addonRoot": true,
    "diagnostics": {
        "disable": [
            "inject-field"
        ],
        "enable": [
            "missing-param-annotation",
            "missing-return-annotation",
            "need-check-nil",
            "unknown-field-type",
            "unknown-local-type",
            "unknown-param-type",
            "unknown-return-type"
        ],
        "severity": {
            "code-after-break": "error",
            "empty-block": "warning",
            "missing-param-annotation": "warning",
            "missing-return-annotation": "warning",
            "not-precedence": "error",
            "redefined-local": "error",
            "redundant-return": "error",
            "shadowed-local": "error",
            "unknown-field-type": "warning",
            "unknown-local-type": "warning",
            "unknown-param-type": "warning",
            "unknown-return-type": "warning",
            "unreachable-code": "error"
        }
    },
    "flavors": [
        "retail"
    ],
    "globals": {
        "write": [
            "PetLeash",
            "PetLeashOptionsDialog",
            "PetLeashOptionsButton"
        ]
    }
}